        200,
        40
      ]
    },
    {
      "parameters": {
        "content": "### ✅ COD Confirmation Sent\nTemplate `cod_order_confirmation` sent to customer.\n\nCustomer will reply via WhatsApp → MSG91 webhook → Nerva → `conversation-processing` webhook → handled in Workflow 3.",
        "height": 160,
        "width": 300
