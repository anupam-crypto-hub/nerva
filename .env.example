# ============================================================
# NOTIFICATION MODULE - Environment Configuration Template
# Multi-Tenant Commerce Engagement & Recovery Platform
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control
# ============================================================

# -----------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------
NODE_ENV=development
API_PORT=5010
WORKER_PORT=5011
API_VERSION=v1

# -----------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------
DATABASE_URL=mongodb://localhost:27017/notification_module
DB_NAME=notification_module

# -----------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------
# Queue Provider (sqs | n8n)
# -----------------------------------------------------------
# Set to 'n8n' to route messages to n8n webhooks instead of SQS
QUEUE_PROVIDER=sqs
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# -----------------------------------------------------------
# AWS SQS Queues (used when QUEUE_PROVIDER=sqs)
# -----------------------------------------------------------
# For local dev, use ElasticMQ endpoint:
# SQS_ENDPOINT=http://localhost:9324

SQS_QUEUE_PREFIX=notification-module
SQS_EVENT_PROCESSING_QUEUE=notification-module-event-processing
SQS_EVENT_PROCESSING_DLQ=notification-module-event-processing-dlq
SQS_WORKFLOW_EXECUTION_QUEUE=notification-module-workflow-execution
SQS_WORKFLOW_EXECUTION_DLQ=notification-module-workflow-execution-dlq
SQS_COMMUNICATION_QUEUE=notification-module-communication
SQS_COMMUNICATION_DLQ=notification-module-communication-dlq
SQS_CONVERSATION_PROCESSING_QUEUE=notification-module-conversation-processing
SQS_CONVERSATION_PROCESSING_DLQ=notification-module-conversation-processing-dlq
SQS_AI_PROCESSING_QUEUE=notification-module-ai-processing
SQS_AI_PROCESSING_DLQ=notification-module-ai-processing-dlq
SQS_WEBHOOK_DELIVERY_QUEUE=notification-module-webhook-delivery
SQS_WEBHOOK_DELIVERY_DLQ=notification-module-webhook-delivery-dlq

# -----------------------------------------------------------
# AI / LLM Configuration
# -----------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.1

# -----------------------------------------------------------
# MSG91 — WhatsApp & SMS Provider
# -----------------------------------------------------------
MSG91_AUTHKEY=
MSG91_INTEGRATED_NUMBER=
MSG91_WHATSAPP_BASE_URL=https://control.msg91.com/api/v5/whatsapp

# -----------------------------------------------------------
# Email / SMTP Configuration (AWS SES)
# -----------------------------------------------------------
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# -----------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------
JWT_SECRET=
API_KEY_SALT_ROUNDS=12
WEBHOOK_SIGNATURE_SECRET=
NERVA_API_KEY=

# -----------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_EVENTS_PER_MINUTE=500

# -----------------------------------------------------------
# Webhook Delivery Configuration
# -----------------------------------------------------------
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_DELIVERY_MAX_RETRIES=5
WEBHOOK_DELIVERY_BACKOFF_BASE_MS=1000

# -----------------------------------------------------------
# Workflow Engine Configuration
# -----------------------------------------------------------
WORKFLOW_DEFAULT_TIMEOUT_HOURS=24
WORKFLOW_MAX_CONCURRENT_EXECUTIONS=100
WORKFLOW_STEP_RETRY_MAX=3

# -----------------------------------------------------------
# AWS S3 (for media storage)
# -----------------------------------------------------------
AWS_S3_BUCKET_NAME=
UPLOAD_AWS_ACCESS_KEY_ID=
UPLOAD_AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------
# Razorpay (future: COD → Prepaid payment links)
# -----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------
# External Service URLs
# -----------------------------------------------------------
JIFFY_API_URL=https://api.jiffy.world/
QUICKFLO_API_URL=https://api.quickflo.ai

# -----------------------------------------------------------
# Support Contact
# -----------------------------------------------------------
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=

# -----------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
NEW_RELIC_APP_NAME=notification-module
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false

# -----------------------------------------------------------
# Docker (local development port mappings)
# -----------------------------------------------------------
DOCKER_MONGODB_PORT=27018
DOCKER_REDIS_PORT=6380
DOCKER_ELASTICMQ_PORT=9324
