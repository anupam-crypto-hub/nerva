# ============================================================
# NERVA v2 — Notification Bridge Configuration
# ============================================================

# Server
NODE_ENV=development
PORT=5010
API_PREFIX=v1
APP_BASE_URL=https://api.yourdomain.com

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nerva?retryWrites=true&w=majority
DB_NAME=nerva

# Redis (BullMQ queue backend + caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Queue Configuration
BULL_QUEUE_CONCURRENCY=50
BULL_MAX_RETRIES=3
BULL_RETRY_BACKOFF_MS=2000

# MSG91
MSG91_AUTHKEY=your_msg91_authkey
MSG91_INTEGRATED_NUMBER=your_integrated_number
MSG91_BASE_URL=https://control.msg91.com/api/v5/whatsapp

# Auth
ADMIN_API_KEY=your_admin_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
